    "/transactions": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "occurredAt",
                  "amount",
                  "accountId",
                  "paymentMethod"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "description": "One of: Income, Expense",
                    "type": "string"
                  },
                  "occurredAt": {
                    "description": "ISO-8601 instant with offset, e.g. 2026-10-05T14:30:00-03:00",
                    "type": "string"
                  },
                  "amount": {
                    "description": "Decimal string, > 0, up to 12 integer digits and 2 decimals",
                    "type": "string"
                  },
                  "accountId": {
                    "type": "string"
                  },
                  "categoryId": {
                    "type": "string"
                  },
                  "paymentMethod": {
                    "description": "One of: BankTransfer, Boleto, Cash, CreditCard, DebitCard, NuPay, PIX",
                    "type": "string"
                  },
                  "notes": {
                    "type": "string",
                    "nullable": true
                  },
                  "receipt": {
                    "type": "string",
                    "nullable": true
                  },
                  "neutral": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "accountId",
                    "accountNickname",
                    "categoryId",
                    "categoryName",
                    "name",
                    "type",
                    "occurredAt",
                    "amount",
                    "paymentMethod",
                    "notes",
                    "receipt",
                    "neutral",
                    "counterpartyDocument",
                    "counterpartyBank"
                  ],
                  "properties": {
                    "id": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "accountId": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "accountNickname": {
                      "type": "string"
                    },
                    "categoryId": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "categoryName": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "Income",
                        "Expense"
                      ]
                    },
                    "occurredAt": {
                      "format": "date-time",
                      "description": "ISO-8601 instant in UTC",
                      "type": "string"
                    },
                    "amount": {
                      "description": "Positive decimal string with 2 decimals, e.g. \"1234.56\"",
                      "type": "string"
                    },
                    "paymentMethod": {
                      "type": "string",
                      "enum": [
                        "BankTransfer",
                        "Boleto",
                        "Cash",
                        "CreditCard",
                        "DebitCard",
                        "NuPay",
                        "PIX"
                      ]
                    },
                    "notes": {
                      "type": "string",
                      "nullable": true
                    },
                    "receipt": {
                      "type": "string",
                      "nullable": true
                    },
                    "neutral": {
                      "type": "boolean"
                    },
                    "counterpartyDocument": {
                      "type": "string",
                      "nullable": true
                    },
                    "counterpartyBank": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
