# Copy to `.env` (git-ignored). `pnpm dev` and `pnpm start` load it automatically.
# Values below match the local Supabase stack (`pnpm db:start`, project id `financials`).

# Supabase project URL. User tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=http://127.0.0.1:55321

# Postgres URL of a role that may `set role authenticated` (local default superuser; use a dedicated
# role that does not bypass RLS in production).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Optional legacy HS256 secret. When set, tokens are verified with it instead of the JWKS.
# SUPABASE_JWT_SECRET=

# Where the API listens.
PORT=3001
HOST=127.0.0.1

# Exact browser origins allowed by CORS, comma separated, no wildcard. Empty means none.
# The front runs on one of these in development.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
