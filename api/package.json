{
  "name": "financials-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test": "pnpm test:unit && pnpm test:int",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:start": "npx supabase --workdir .. start",
    "db:stop": "npx supabase --workdir .. stop",
    "db:reset": "npx supabase --workdir .. db reset",
    "db:status": "npx supabase --workdir .. status"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
